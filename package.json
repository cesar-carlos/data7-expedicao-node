{
  "name": "server-api-data7",
  "author": "cesar carlos",
  "version": "1.1.9",
  "description": "Servidor data7 para integração",
  "bin": "./dist.loja/src/server.js",
  "main": "server.js",
  "license": "ISC",
  "engines": {
    "node": ">=24 <27"
  },
  "keywords": [],
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/server.ts",
    "dev:nodemon": "cls && nodemon --watch 'src/' --exec 'ts-node --files --transpile-only src/server.ts' -e ts",
    "build:wind": "tsc && copyfiles ./.env ./dist/src/ && copyfiles ./src/sql/**/* ./dist/",
    "build:wind:loja": "tsc --outDir ./dist.loja && copyfiles ./package.json ./dist.loja/src/ && copyfiles ./.env ./dist.loja/src/ && copyfiles ./src/sql/**/* ./dist.loja/",
    "format": "npx prettier './src/**/*.ts' './src/**/*.js' --write",
    "start": "node ./dist.loja/src/server.js",
    "test": "vitest",
    "bench:consultas": "ts-node test/performance/consultas.benchmark.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.6",
    "currency-formatter": "^1.5.9",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "morgan": "^1.12.1",
    "mssql": "^12.7.14",
    "promisify": "^0.0.3",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tedious": "^20.3.8",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/currency-formatter": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/tedious": "^18.0.0",
    "copyfiles": "^2.4.1",
    "jsdom": "^31.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-watch": "^7.2.1",
    "tslib": "^2.9.1",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
