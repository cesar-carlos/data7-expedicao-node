# SQL_POOL_MAX=20
# SQL_POOL_MIN=2
# SQL_POOL_IDLE_TIMEOUT_MS=30000
# SQL_POOL_ACQUIRE_TIMEOUT_MS=60000
# SQL_CONNECTION_TIMEOUT_MS=30000
# SQL_REQUEST_TIMEOUT_MS=30000
# SQL_HEALTHCHECK_TIMEOUT_MS=2000
